<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AIUsage</AssemblyName>
    <StartupObject>AIUsage.Windows.NativeApp</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Inspectable self-contained folder: no native-library extraction into TEMP. -->
    <StartupHookSupport>false</StartupHookSupport>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../AIUsage.Core/AIUsage.Core.csproj" /></ItemGroup>
</Project>
