<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <Description>Independent Windows port of OpenUsage for Codex usage, token and cost monitoring. English and Spanish UI.</Description>
    <Authors>AIUsage contributors</Authors>
    <RepositoryUrl>https://github.com/wandoth1/AIUsage</RepositoryUrl>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
