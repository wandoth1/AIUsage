<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.4.1</Version>
    <Description>Local-only Windows port of OpenUsage for Codex token and estimated cost monitoring. No account access. English and Spanish UI.</Description>
    <Authors>AIUsage contributors</Authors>
    <RepositoryUrl>https://github.com/wandoth1/AIUsage</RepositoryUrl>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
